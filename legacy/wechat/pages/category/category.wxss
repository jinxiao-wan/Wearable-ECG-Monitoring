.bancin{
position: relative;
}
.dingwei{
position: fixed;
top: 80%;
right: 30px;
font-size: small;
text-align: center;
}
.line{
  height: 1px;
  width: 100%;
  background-color: #666;
  opacity: 0.2;
}
.history{
height: 80px;
}
.order{
  padding-top: 15px;
  padding-left: 15px;
  padding-bottom: 15px;
  font-size: 15px;
}
.end{
  color: grey;
  text-align: center;
  font-size: smaller;
}
.text{
  display: flex;
  justify-content: space-around;
  margin-top: 10px;
  font-size: small;
  color: #666;
}
.order1{
  float: left;
  margin-right: 10px;
  text-align: center;
  line-height: 50px;
  font-size: 20px;
  width: 150px;
  height: 50px;
  background-color: #f5f5f5;
}
.order2{
  float: right;
  margin-left: 10px;
  text-align: center;
  line-height: 50px;
  font-size: 20px;
  width: 150px;
  height: 50px;
  background-color: #f5f5f5;
}
.item{
  margin: 0 auto;
  display: flex;
  flex-direction: row;
  width: 320px;
}
